{{ form_start(form, {'attr': {'class': 'space-y-6 bg-white dark:bg-gray-700 p-6 rounded-lg shadow-lg'}}) }}
<div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="mt-3">
            <div class="w-full sm:w-80">
                <label for="{{ form.currency.vars.id }}"
                       class="block text-gray-900 dark:text-gray-300 font-semibold mb-2">
                    {{ 'form.currency'|trans({},'wallet') }}
                </label>

                {{ form_widget(form.currency, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md border text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent' ~
                        (form.currency.vars.errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-gray-300 dark:bg-gray-800 dark:border-gray-600'),
                        'placeholder': 'form.currency'|trans({},'wallet')
                    }
                }) }}

                {% if form.currency.vars.errors|length > 0 %}
                    <p class="text-red-500 dark:text-red-400 text-sm mt-1">
                        {{ field.vars.errors[0].message }}
                    </p>
                {% endif %}
            </div>
        </div>
        <div class="mt-3">
            <div class="w-full sm:w-80">
                <label for="{{ form.name.vars.id }}"
                       class="block text-gray-900 dark:text-gray-300 font-semibold mb-2">
                    {{ 'form.name'|trans({},'wallet') }}
                </label>

                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md border text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent' ~
                        (form.name.vars.errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-gray-300 dark:bg-gray-800 dark:border-gray-600'),
                        'placeholder': 'form.name'|trans({},'wallet')
                    }
                }) }}

                {% if form.name.vars.errors|length > 0 %}
                    <p class="text-red-500 dark:text-red-400 text-sm mt-1">
                        {{ field.vars.errors[0].message }}
                    </p>
                {% endif %}
            </div>
        </div>
        <div class="mt-3">
            <div class="w-full sm:w-80">
                <label for="{{ form.amount.vars.id }}"
                       class="block text-gray-900 dark:text-gray-300 font-semibold mb-2">
                    {{ 'form.amount'|trans({},'wallet') }}
                </label>

                {{ form_widget(form.amount, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md border text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent' ~
                        (form.amount.vars.errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-gray-300 dark:bg-gray-800 dark:border-gray-600'),
                        'placeholder': 'form.amount'|trans({},'wallet')
                    }
                }) }}

                {% if form.amount.vars.errors|length > 0 %}
                    <p class="text-red-500 dark:text-red-400 text-sm mt-1">
                        {{ field.vars.errors[0].message }}
                    </p>
                {% endif %}
            </div>
        </div>
        <div class="mt-3">
            <div class="w-full sm:w-80">
                <label for="{{ form.isMain.vars.id }}"
                       class="block text-gray-900 dark:text-gray-300 font-semibold mb-2">
                    {{ 'form.is_main'|trans({},'wallet') }}
                </label>

                {{ form_widget(form.isMain, {
                    'attr': {
                        'class': 'w-full p-3 rounded-md border text-gray-900 dark:text-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent' ~
                        (form.isMain.vars.errors|length > 0 ? 'border-red-500 dark:border-red-400' : 'border-gray-300 dark:bg-gray-800 dark:border-gray-600'),
                        'placeholder': 'form.is_main'|trans({},'wallet')
                    }
                }) }}

                {% if form.isMain.vars.errors|length > 0 %}
                    <p class="text-red-500 dark:text-red-400 text-sm mt-1">
                        {{ field.vars.errors[0].message }}
                    </p>
                {% endif %}
            </div>
        </div>

    </div>
    <div class="mt-4 flex justify-between items-center">
        {{ include('component/_button.html.twig' ,{'button_label': 'form.save'|trans({},'wallet')}) }}
        {{ include('component/_link.html.twig') }}
    </div>
</div>

{{ form_end(form) }}