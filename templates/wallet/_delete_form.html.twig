<form class="float-end" method="post" action="{{ path('app_wallet_delete', {'number': wallet.number}) }}"
      onsubmit="return confirm({{ 'confirm_message'|trans({}, 'base') }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ wallet.number) }}">
    <button class="btn btn-danger text-white bg-red-500 hover:bg-red-600 rounded-lg px-4 py-2">
        {{ 'show.delete'|trans({},'wallet') }}
    </button>
</form>