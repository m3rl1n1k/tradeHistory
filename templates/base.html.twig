<!doctype html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>{% block title %}{% endblock %}</title>
    <link href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='size-6'>
    <path d='M3 3v18h18'/>
    <rect x='6' y='14' width='3' height='5'/>
    <rect x='11' y='10' width='3' height='9'/>
    <rect x='16' y='6' width='3' height='13'/>
    </svg>
    "
          rel="icon">
    <link rel="stylesheet" href="{{ asset('assets/app.tailwind.css') }}">
    {% block stylesheets %}
    {% endblock %}
    <style>
        .fade-out {
            opacity: 0;
            transition: opacity 5s ease;
        }
    </style>
</head>
<body class="dark:bg-gray-800 bg-gray-300 min-h-scree">
<header class="flex justify-between items-center p-4 bg-white dark:bg-gray-800 shadow-md">
    <div class="text-xl font-semibold dark:text-white" id="title">
        <a href="{{ path('app_home') }}">{{ 'index.title'|trans({}, 'base') }}</a>
    </div>
    <div class="flex items-center space-x-4 max-w-full">
        {{ include('component/_search.html.twig') }}
    </div>
    {{ include('component/_mobile_menu_btn.html.twig') }}
</header>
<div class="flex body relative">
    {{ include('component/_navigation.html.twig') }}
    <div class="flex-1 p-4 z-0 fade hidden" id="search-result"></div>
    <main class="flex-1 p-4 z-0" id="main-block">
        {{ include('component/_flash.html.twig') }}
        {% block body %}{% endblock body %}
    </main>
</div>
<script src="{{ asset('assets/js/hide_user_sum.js') }}"></script>
<script src="{{ asset('assets/js/menu.js') }}"></script>
<script src="{{ asset('assets/js/search.js') }}"></script>
<script src="{{ asset('assets/js/autocloser_flash.js') }}"></script>
<script src="{{ asset('assets/js/toggle-theme.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>