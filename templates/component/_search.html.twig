<form class="w-full max-w-sm" id="search-form" method="GET">
    <div class="relative">
        <div class="justify-between hidden " id="search-group">
            <button class="px-4 py-2 bg-gray-400 text-gray-600 dark:bg-gray-900 dark:text-gray-400 border border-gray-400 rounded-l-lg hover:cursor-pointer"
                    id="close-btn"
                    type="button">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                </svg>

            </button>
            <input aria-label="{{ 'search.button'|trans({}, 'base') }}"
                   class="w-full focus:rounded-none px-4 py-2 border-t border-b border-gray-400 relative text-gray-700 border dark:text-gray-300"
                   id="search-input"
                   name="search"
                   placeholder="{{ 'search.placeholder'|trans({}, 'base') }}"
                   required
                   type="text">
            <div class="hidden loader border-4 border-gray-500 dark:border-gray-300" id="loader"></div>
            <button class="px-4 border bg-gray-400 text-gray-600 dark:bg-gray-900 dark:text-gray-400 border-gray-400 rounded-r-lg text-lg hover:cursor-pointer"
                    id="search-btn"
                    type="submit">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                     stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
                </svg>

            </button>
        </div>
    </div>
    <button class="bg-gray-600 text-white p-2 rounded-lg"
            id="open-btn"
            type="button">{{ 'search.button'|trans({}, 'base') }}
    </button>
</form>