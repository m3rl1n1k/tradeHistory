{% extends 'base.html.twig' %}

{% block title %}{{ 'title'|trans({}, 'dashboard') }}{% endblock %}

{% block stylesheets %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

{% block body %}
    {% if app.user.currency() is empty %}
        <div class="mt-3">
            <a href="{{ path('app_user_index', { 'id':app.user.id() }) }}"
               class="bg-red-500 text-white px-6 py-3 rounded-lg text-lg hover:bg-red-600 transition-colors">
                {{ 'set_currency'|trans({}, 'menu') }}
            </a>
        </div>
    {% endif %}
    <main class="flex-1 p-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 dark:text-gray-300">
            <div class="bg-white dark:bg-gray-600 shadow-lg p-4 rounded-lg">
                <h3 class="text-lg font-semibold my-2">{{ 'quick.title'|trans({}, 'dashboard') }}</h3>
                <div class="flex flex-col">
                    <a href="{{ path('app_transaction_new') }}"
                       class="text-center w-full bg-green-500 text-white p-2 rounded-lg mt-4">
                        {{ 'quick.transaction'|trans({}, 'dashboard') }}</a>
                    <a href="{{ path('app_budget_new') }}"
                       class="text-center w-full bg-yellow-500 text-white p-2 rounded-lg mt-4">
                        {{ 'quick.budget'|trans({}, 'dashboard') }}</a>
                    <a href="{{ path('app_category_new') }}"
                       class="text-center w-full bg-blue-500 text-white p-2 rounded-lg mt-4">
                        {{ 'quick.category'|trans({}, 'dashboard') }}</a>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-600 shadow-lg p-4 rounded-lg dark:text-gray-300">
                <h3 class="text-lg font-semibold">{{ 'chart.title'|trans({}, 'dashboard') }}</h3>
                <canvas id="expenseChart"></canvas>
                <h4 class="text-lg font-semibold">{{ 'chart.total'| trans({}, 'dashboard') }} {{ expense_amount }} {{ app.user.currency }}</h4>
            </div>
            <div class="bg-white dark:bg-gray-600 shadow-lg p-4 rounded-lg dark:text-gray-300 flex justify-between ">
                <div class="">
                    <h3 class="text-lg font-semibold">{{ 'last_transaction'|trans({}, 'dashboard') }}</h3>
                    <ul class="space-y-2 over">
                        {% if last_transaction|length > 0 %}
                            {% for transaction in last_transaction %}
                                <li class="flex items-center">
                                    {{ include('component/_transaction_type.html.twig', {'type' : transaction.type}) }}
                                    <a class="text-decoration-none {{ color(transaction.type) }} hover:underline"
                                       href="{{ path('app_transaction_show', {'id': transaction.id}) }}">
                                        &nbsp;{{ transaction.amount }} <span
                                                class="text-xs">{{ transaction.wallet.currency }}</span> -
                                        {{ transaction.category.name ?? '' }} -
                                        {{ transaction.date|date('d M') }}
                                    </a>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li>{{ 'not_found_records'|trans({}, 'dashboard') }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-600 shadow-lg p-4 rounded-lg dark:text-gray-300">
                <div class="">
                    <h3 class="text-lg font-semibold">{{ 'current_budget'|trans({}, 'dashboard') }}</h3>
                    {% for date, budget in current_budget %}
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="text-lg font-semibold text-gray-900 dark:text-white">{{ date|date('M Y') }}</h4>
                            <a class="" href="{{ path('app_budget_show', {'month' : date}) }}"><span
                                        class="text-sm text-gray-500 dark:text-gray-400">{{ 'index.card.overview'|trans({}, 'buget') }}</span></a>
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between">
                                <span class="text-gray-600 dark:text-gray-300">{{ 'index.card.planned'|trans({}, 'buget') }}:</span>
                                <span class="font-medium text-gray-900 dark:text-white">{{ budget.totalPlanned }} {{ app.user.currency }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600 dark:text-gray-300">{{ 'index.card.actual'|trans({}, 'buget') }}:</span>
                                <span class="font-medium text-red-500 dark:text-red-400">{{ budget.totalActual }} {{ app.user.currency }}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600 dark:text-gray-300">{{ 'index.card.remaining'|trans({}, 'buget') }}:</span>
                                <span class="font-medium {% if (budget.totalPlanned - budget.totalActual) < 0 %}
                            text-red-500 dark:text-red-400 {% else %} text-green-500 dark:text-green-400 {% endif %}">
                {{ budget.totalPlanned - budget.totalActual }} {{ app.user.currency }}</span>
                            </div>

                            {# Прогрес-бар #}
                            {% set percent = (budget.totalActual / budget.totalPlanned) * 100 %}
                            <div class="mb-1 text-base font-medium {% if percent < 50 %} text-green-700 dark:text-green-500
                        {% elseif percent < 80 %} text-yellow-700 dark:text-yellow-500
                        {% else %} text-red-700 dark:text-red-500 {% endif %}">
                                {{ percent|round(1) }}% {{ 'index.card.spent'|trans({}, 'buget') }}
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                                <div class="h-2.5 rounded-full transition-all"
                                     style="width: {{ percent > 100 ? 100 : percent }}%;
                                             background-color: {% if percent < 50 %} #10B981
                                     {% elseif percent < 80 %} #FBBF24
                                     {% else %} #EF4444 {% endif %};">
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="bg-white dark:bg-gray-600 shadow-lg p-4 rounded-lg dark:text-gray-300 flex justify-between ">
                <div class="">
                    <h3 class="text-lg font-semibold">{{ 'total'|trans({}, 'dashboard') }}</h3>
                    <p class="text-2xl font-bold text-green-600 replace-block">
                        ~ {{ amount ? amount : 0 }} {{ app.user.currency }}</p>
                    <span class="stars hidden text-2xl font-bold text-green-600">******</span>
                    <ul class="space-y-2 over">
                        {% if app.user.wallets|length > 0 %}
                            {% for wallet in app.user.wallets %}
                                <li>{{ wallet.name ?? wallet.number }} -
                                    <span class="replace-block">{{ wallet.amount }}</span>
                                    <span class="stars hidden">******</span>
                                    <span class="text-sm">{{ wallet.currency }}</span>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li>{{ 'not_found_records'|trans({}, 'dashboard') }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script type="application/javascript">
        function getThemeColor() {
            if (document.documentElement.classList.contains('dark')) {
                return 'white'; // Dark mode: White text color
            } else {
                return 'black'; // Light mode: Black text color
            }
        }

        const ctx = document.getElementById('expenseChart').getContext('2d');
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: {{ labels|raw }},
                datasets: [{
                    data: {{ data|raw }},
                    backgroundColor: {{ colors|raw }},
                    color: ['#eeee']
                }]
            },
            options: {
                plugins: {
                    legend: {
                        labels: {
                            color: getThemeColor() // Set the legend text color based on theme
                        }
                    }
                },
                responsive: true,
            }
        });
    </script>
{% endblock %}