{% extends 'main_base.html.twig' %}

{% block title %}{{ 'title'|trans({},'login') }}{% endblock %}

{% block body %}
    <div class="h-full flex items-center justify-center">
        <form method="post" class="w-full max-w-sm p-6 shadow-lg rounded-lg">
            {% if error %}
                <div class="bg-red-100 text-red-700 px-4 py-2 rounded mb-4 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            <h1 class="text-2xl font-bold text-center mb-6 text-gray-300">{{ 'title'|trans({},'login') }}</h1>

            <div class="mb-4">
                <label for="inputEmail"
                       class="block text-sm font-medium text-gray-300">{{ 'email.label'|trans({},'login') }}</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                       class="dark:text-gray-200 mt-1 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 text-gray-600"
                       autocomplete="email" required autofocus
                       placeholder="{{ 'email.placeholder'|trans({},'login') }}">
            </div>

            <div class="mb-4 relative">
                <label for="inputPassword"
                       class="block text-sm font-medium text-gray-300">{{ 'password.label'|trans({},'login') }}</label>
                <div class="relative">
                    <input type="password" name="password" id="inputPassword"
                           class="dark:text-gray-200 mt-1 block w-full px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 pr-10 text-gray-600"
                           autocomplete="current-password" required
                           placeholder="{{ 'password.placeholder'|trans({},'login') }}">
                    <button id="togglePassword" class="w-5 h-5 absolute top-3 right-2 text-gray-600">
                        <svg id="eye-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"></path>
                        </svg>
                        <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke-width="1.5"
                             stroke="currentColor"
                             class="size-6 hidden">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="flex flex-col space-y-4">
                <button class="bg-blue-500 text-white w-full py-2 px-4 rounded-md hover:bg-blue-600 transition"
                        type="submit">
                    {{ 'sign_in'|trans({},'login') }}
                </button>

                <a href="{{ path('app_register') }}"
                   class="text-center text-sm text-blue-500 hover:text-blue-700 transition">
                    {{ 'register'|trans({},'login') }}
                </a>
            </div>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const btn_switch = document.getElementById('togglePassword')
        const eye_open = document.getElementById('eye-open')
        const eye_close = document.getElementById('eye-close')

        function switch_eye() {
            eye_close.classList.toggle('hidden')
            eye_open.classList.toggle('hidden')
        }


        btn_switch.addEventListener('click', function (e) {
            e.preventDefault()
            switch_eye()
        })


        document.getElementById("togglePassword").addEventListener("click", function () {
            const passwordField = document.getElementById("inputPassword");
            passwordField.type = passwordField.type === "password" ? "text" : "password";
        });
    </script>
{% endblock %}