<form class="float-end" method="post" action="{{ path('app_budget_delete', {'id': category.budgetId}) }}"
      onsubmit="return confirm({{ 'confirm_message'|trans({}, 'base') }});">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.budgetId) }}">
    <button class="text-sm text-red-500 dark:text-red-400 hover:cursor-pointer">{{ 'show.card.delete'|trans({}, 'buget') }}</button>
</form>